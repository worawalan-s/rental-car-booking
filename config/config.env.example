NODE_ENV=development
PORT=5000

# MongoDB Connection String (Replace with your database credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/RentalCarBooking?retryWrites=true&w=majority

# JWT Authentication Config
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Redis Cache Config (Task 11)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300

# AWS S3 Storage Config (Optional - falls back to local storage if omitted)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=
AWS_S3_CUSTOM_DOMAIN=
