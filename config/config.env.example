NODE_ENV=development
PORT=5000

# MongoDB Connection String (Replace with your database credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/RentalCarBooking?retryWrites=true&w=majority

# JWT Authentication Config
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30
